<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Keys matched against two menu-bar apps that work on the same Mac
       (SmackMyMacUp, ItsGOATtime) after this one would not appear at all.
       Individually they look cosmetic; together they are the difference
       between a bundle macOS treats as an app and one it does not. The icon
       matters most: System Settings ▸ Control Center lists menu bar apps BY
       THEIR ICON, and this bundle had none. -->
  <key>CFBundleDevelopmentRegion</key><string>en</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundleIconName</key><string>AppIcon</string>
  <key>NSSupportsAutomaticTermination</key><true/>
  <key>NSSupportsSuddenTermination</key><false/>
  <key>CFBundleName</key><string>REFUGIO</string>
  <key>CFBundleDisplayName</key><string>REFUGIO</string>
  <!-- macOS 26 keeps a per-app allow-list of menu bar icons, keyed by BUNDLE ID,
       in Control Center's group container. A blocked identifier can stay blocked
       even after the user re-enables it in System Settings, because another
       app's stale entry can list this one and apply its own isAllowed = false.
       The only reliable escape is a bundle ID the system has never seen — hence
       this one, and hence REFUGIO_BUNDLE_ID in install.sh for the next time. -->
  <key>CFBundleIdentifier</key><string>com.phantazein.refugio.app</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>CFBundleShortVersionString</key><string>0.1</string>
  <key>CFBundleExecutable</key><string>RefugioBar</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSPrincipalClass</key><string>NSApplication</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <!-- Menu-bar agent: no Dock icon, lives in the status bar. -->
  <key>LSUIElement</key><true/>
</dict>
</plist>
