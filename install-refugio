#!/bin/bash
# REFUGIO Zero-Prereq Installer (macOS)
# Usage: curl -fsSL https://raw.githubusercontent.com/Phantazein-apps/refugio/main/install-refugio | bash
#
# Installs Node.js if missing, then runs the Node-based installer.
#
# This repository builds two products, and this script installs one of them.
# The other has its own bootstrap, install-listener, which is this same file
# with REFUGIO_EDITION preset — see docs/editions.md. REFUGIO_EDITION is
# honoured here too, so a caller who already knows which one they want can say
# so without picking a different URL.

set -e

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[0;33m'
BOLD='\033[1m'
NC='\033[0m'

ok()   { printf "  ${GREEN}✓${NC} %s\n" "$1"; }
warn() { printf "  ${YELLOW}!${NC} %s\n" "$1"; }
fail() { printf "  ${RED}✗${NC} %s\n" "$1"; exit 1; }

# Which product. Set by install-listener before it sources the same logic;
# settable by hand for anyone driving this script directly.
export REFUGIO_EDITION="${REFUGIO_EDITION:-standard}"
case "$REFUGIO_EDITION" in
  standard) PRODUCT="REFUGIO" ;;
  listener) PRODUCT="REFUGIO Listener" ;;
  *) printf "  \033[0;31m✗\033[0m Unknown REFUGIO_EDITION '%s' — expected standard or listener\n" "$REFUGIO_EDITION"; exit 1 ;;
esac

echo ""
echo -e "${BOLD}============================================================"
echo " 🏔️  ${PRODUCT} Installer"
echo -e "============================================================${NC}"
echo ""

# ── macOS only ────────────────────────────────────────────────
# Checked before anything is installed: Node, git and everything after them
# are fetched the Mac way, and REFUGIO itself runs under launchd with a
# menu-bar app. Stopping here costs nothing; stopping later leaves a half
# install behind.
if [ "$(uname -s)" != "Darwin" ]; then
  fail "${PRODUCT} runs on macOS only — this installer cannot set it up on $(uname -s)."
fi

# ── Install Node.js if missing ────────────────────────────────

install_node() {
  if command -v node &>/dev/null; then
    local ver
    ver=$(node --version | sed 's/v//' | cut -d. -f1)
    if [ "$ver" -ge 18 ]; then
      ok "Node.js ($(node --version))"
      return
    fi
    warn "Node.js $(node --version) is too old — upgrading..."
  else
    warn "Node.js not found — installing..."
  fi

  if command -v brew &>/dev/null; then
    brew install node
  else
    # Official .pkg — no brew needed
    warn "Downloading Node.js from nodejs.org..."
    local pkg_file
    pkg_file=$(mktemp /tmp/node-install.XXXXXX.pkg)
    curl -fsSL "https://nodejs.org/dist/v22.16.0/node-v22.16.0.pkg" -o "$pkg_file"
    sudo installer -pkg "$pkg_file" -target /
    rm -f "$pkg_file"
  fi

  if command -v node &>/dev/null; then
    ok "Node.js installed ($(node --version))"
  else
    fail "Node.js installation failed — install manually from https://nodejs.org"
  fi
}

# ── Install Git if missing ────────────────────────────────────

install_git() {
  if command -v git &>/dev/null; then
    ok "Git ($(git --version | awk '{print $3}'))"
    return
  fi

  warn "Git not found — installing..."
  xcode-select --install 2>/dev/null || brew install git

  if command -v git &>/dev/null; then
    ok "Git installed"
  else
    fail "Git installation failed — install manually from https://git-scm.com"
  fi
}

# ── Main ──────────────────────────────────────────────────────

install_git
install_node

echo ""

# Download and run the Node installer.
#
# Pinned to the stable release by default — `main` is the integration branch
# and may carry half-finished work, so installing from it is now opt-in. This
# ref is used by BOTH this bootstrap and the repo clone in install-node.cjs,
# so a pinned install is pinned end to end.
#   v2 alpha (default): curl … | bash
#   bleeding edge:      REFUGIO_VERSION=main curl … | bash
#
# The default is an ALPHA. That is a deliberate choice: the only older release
# is built on an interface REFUGIO has retired, so pointing new installs at it
# would be sending people to a dead end. The README says plainly that the
# default is an early prototype.
#
# The branch is still named v2.0.0-beta.2 and is NOT being renamed. Every
# existing install tracks that branch by name; renaming it would break their
# `git pull` and the update check with it. The name is a distribution channel,
# not a maturity claim — the claim is the one in the UI and the README.
# Use </dev/tty so interactive prompts read from the terminal, not the pipe
export REFUGIO_VERSION="${REFUGIO_VERSION:-v2.0.0-beta.2}"
TMPFILE=$(mktemp /tmp/refugio-install.XXXXXX)
trap 'rm -f "$TMPFILE"' EXIT INT TERM
curl -fsSL "https://raw.githubusercontent.com/Phantazein-apps/refugio/${REFUGIO_VERSION}/install-node.cjs" > "$TMPFILE"
node "$TMPFILE" "$@" </dev/tty
