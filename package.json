{
  "name": "refugio",
  "version": "2.0.0-beta.2",
  "description": "REFUGIO — a self-hosted refuge for your AI. One command installs a local LLM (Ollama) and REFUGIO's own chat window, with optional personal connectors (WhatsApp via Hermeneia, email via Epistole, Apple Reminders, Things 3, Notion, memory) and business connectors (Slack, Jira, ServiceNow, Salesforce) via MCP. macOS only.",
  "type": "module",
  "main": "server.js",
  "bin": {
    "refugio": "./server.js"
  },
  "scripts": {
    "start": "node start-refugio.cjs",
    "start:server": "node server.js",
    "test": "node --test \"test/*.test.js\"",
    "eval": "node scripts/eval.cjs"
  },
  "keywords": [
    "mcp",
    "local-llm",
    "self-hosted",
    "ollama",
    "macos",
    "ai",
    "slack",
    "notion",
    "jira"
  ],
  "author": "Dennis Kittrell",
  "license": "MIT",
  "optionalDependencies": {
    "@earendil-works/pi-ai": "1.0.1",
    "googleapis": "^171.4.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "dotenv": "^16.4.7",
    "just-claude-things": "github:Phantazein-apps/just-claude-things",
    "mcp-remote": "^0.1.38",
    "node-fetch": "^3.3.2",
    "reminders-mcp": "github:Phantazein-apps/just-claude-reminders"
  }
}
